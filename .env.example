# ReservePro — variables de entorno LOCALES (copiar a .env). Valores de desarrollo; no usar en producción.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_PORT=5432
POSTGRES_DB=reservepro
POSTGRES_OWNER_USER=rp_owner
POSTGRES_OWNER_PASSWORD=rp_owner_dev
RP_APP_PASSWORD=rp_app_dev
RP_SYSTEM_PASSWORD=rp_system_dev

# Migraciones (rol dueño) y runtime (rol sujeto a RLS)
DATABASE_URL_OWNER=postgresql://rp_owner:rp_owner_dev@localhost:5432/reservepro
DATABASE_URL=postgresql://rp_app:rp_app_dev@localhost:5432/reservepro
DATABASE_URL_SYSTEM=postgresql://rp_system:rp_system_dev@localhost:5432/reservepro

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Mailpit (email local) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
