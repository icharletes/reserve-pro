# ReservePro — variables de entorno LOCALES (copiar a .env). Valores de desarrollo; no usar en producción.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_PORT=5432
POSTGRES_DB=reservepro
POSTGRES_OWNER_USER=rp_owner
POSTGRES_OWNER_PASSWORD=rp_owner_dev
RP_APP_PASSWORD=rp_app_dev
RP_SYSTEM_PASSWORD=rp_system_dev

# Migraciones (rol dueño) y runtime (rol sujeto a RLS)
DATABASE_URL_OWNER=postgresql://rp_owner:rp_owner_dev@localhost:5432/reservepro
DATABASE_URL=postgresql://rp_app:rp_app_dev@localhost:5432/reservepro
DATABASE_URL_SYSTEM=postgresql://rp_system:rp_system_dev@localhost:5432/reservepro

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Mailpit (email local) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (NestJS) ---
API_PORT=3000
LOG_LEVEL=info
# Secreto de firma del access token: mínimo 32 caracteres. En producción: aleatorio y distinto por entorno.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Orígenes permitidos por CORS (portal Astro y panel Vue en local)
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
