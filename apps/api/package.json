{
  "name": "@reservepro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de ReservePro (NestJS). Dos entrypoints: main.ts (HTTP) y worker.ts (BullMQ).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:generate": "tsc -p tsconfig.build.json && node dist/scripts/generate-openapi.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@reservepro/booking-domain": "workspace:^",
    "@reservepro/contracts": "workspace:^",
    "@reservepro/database": "workspace:^",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "nestjs-cls": "^7.0.2",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
