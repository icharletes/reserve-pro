{
  "name": "reservepro",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,vue,astro,json,md,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,vue,astro,json,md,yml}\" --ignore-path .gitignore",
    "db:up": "docker compose up -d postgres redis mailpit",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis mailpit"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
