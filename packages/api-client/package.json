{
  "name": "@reservepro/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cliente tipado de la API de ReservePro (panel y portal). Valida las respuestas con los contratos.",
  "main": "./dist/index.js",
