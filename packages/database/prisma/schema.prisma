  tenant_id      String       @db.Uuid
  reservation_id String       @db.Uuid
  type           String
  actor_type     String
  actor_id       String?      @db.Uuid
  channel        String?
  payload        Json         @default("{}")
  occurred_at    DateTime     @default(now()) @db.Timestamptz(6)
  reservations   reservations @relation(fields: [tenant_id, reservation_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, reservation_id, occurred_at], map: "ix_reservation_events")
}

