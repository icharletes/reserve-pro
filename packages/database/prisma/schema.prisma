  locations   locations @relation(fields: [tenant_id, location_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  services    services  @relation(fields: [tenant_id, service_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([service_id, location_id])
  @@index([tenant_id, location_id], map: "ix_service_locations_location")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model service_resources {
  tenant_id        String    @db.Uuid
  service_id       String    @db.Uuid
  resource_id      String    @db.Uuid
  requirement_slot Int       @default(1) @db.SmallInt
  resources        resources @relation(fields: [tenant_id, resource_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  services         services  @relation(fields: [tenant_id, service_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([service_id, resource_id])
  @@index([tenant_id, resource_id], map: "ix_service_resources_resource")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  id                    String              @id @db.Uuid
  tenant_id             String              @db.Uuid
  category_id           String?             @db.Uuid
  name                  String              @db.Citext
  description           String?
  duration_minutes      Int
  buffer_before_minutes Int                 @default(0)
  buffer_after_minutes  Int                 @default(0)
  price                 Decimal             @db.Decimal(12, 2)
  currency              String              @db.Char(3)
  min_notice_minutes    Int?
  max_advance_days      Int?
  requires_confirmation Boolean?
  image_url             String?             @db.VarChar(500)
  is_active             Boolean             @default(true)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @db.Timestamptz(6)
  service_locations     service_locations[]
  service_resources     service_resources[]
  service_categories    service_categories? @relation(fields: [tenant_id, category_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenants               tenants             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active], map: "ix_services_tenant_active")
}
